# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=ai_chat_mvp
# Dev convenience only - use real migrations in production
DB_SYNCHRONIZE=true

# Backend
PORT=4000

# JWT - use a long random value in any real deployment
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=1d

# Initial admin seeded at startup if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# AI
AI_REQUEST_TIMEOUT_MS=60000
